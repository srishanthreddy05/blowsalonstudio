rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Core ERP collections: allow read and write access
    match /invoices/{document=**} {
      allow read, write: if true;
    }
    
    match /customers/{document=**} {
      allow read, write: if true;
    }
    
    match /products/{document=**} {
      allow read, write: if true;
    }
    
    match /expenses/{document=**} {
      allow read, write: if true;
    }

    match /services/{document=**} {
      allow read, write: if true;
    }

    match /serviceCategories/{document=**} {
      allow read, write: if true;
    }

    match /offers/{document=**} {
      allow read, write: if true;
    }

    match /packages/{document=**} {
      allow read, write: if true;
    }

    match /stats/{document=**} {
      allow read, write: if true;
    }

    match /staff/{document=**} {
      allow read, write: if true;
    }
    
    match /settings/{document=**} {
      allow read, write: if true;
    }

    match /notifications/{document=**} {
      allow read, write: if true;
    }

    match /settlements/{document=**} {
      allow read, write: if true;
    }

    match /credit_balances/{document=**} {
      allow read, write: if true;
    }

    match /advance_balances/{document=**} {
      allow read, write: if true;
    }

    match /users/{document=**} {
      allow read, write: if true;
    }

    match /attendance/{document=**} {
      allow read, write: if true;
    }

    // Catch-all rule for other sub-collections or documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
