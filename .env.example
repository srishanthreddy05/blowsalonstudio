# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=blowsalonstudio.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=blowsalonstudio
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=blowsalonstudio.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# WhatsApp Provider Configuration (meta_cloud | qr)
WHATSAPP_PROVIDER=meta_cloud

# Meta WhatsApp Cloud API Configuration
WHATSAPP_CLOUD_API_VERSION=v21.0
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=1755242905734759
WHATSAPP_BUSINESS_NUMBER=your_registered_phone_number
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_INVOICE_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Persistent WhatsApp Server (QR session fallback only)
WHATSAPP_BACKEND_URL=
WHATSAPP_SERVICE_SECRET=
