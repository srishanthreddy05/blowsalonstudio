# Firebase Client Configuration (Frontend Authentication & Public App Config)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=blowsalonstudio.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=blowsalonstudio
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=blowsalonstudio.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK (Server-Side Privileged Firestore Operations & Queue Worker)
# Option A: Full JSON Service Account Key (stringified or base64)


# Meta WhatsApp Cloud API (Coexistence Architecture)
# Account identity (WABA ID, Phone Number ID, Business Number) is resolved dynamically
# from the validated Firestore Coexistence record (settings/whatsapp_coexistence)
# established via Meta Embedded Signup in the app Settings.
NEXT_PUBLIC_META_APP_ID=2308689169962503
WHATSAPP_CLOUD_API_VERSION=v21.0
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=915476941649186
WHATSAPP_BUSINESS_ACCOUNT_ID=809784711938874
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token
WHATSAPP_APP_SECRET=your_meta_app_secret
# Optional: Template header image URL for approved templates with IMAGE headers
WHATSAPP_TEMPLATE_HEADER_IMAGE_URL=https://blowsalonstudio.vercel.app/blowtemplate.png
CLOUDINARY_CLOUD_NAME=dakgppa8o
CLOUDINARY_UPLOAD_PRESET=blow_salon_campaigns

# WhatsApp Persistent Queue & Throttle Controls
WHATSAPP_SEND_DELAY_MS=3000
WHATSAPP_MAX_CONCURRENCY=1
WHATSAPP_MAX_RETRIES=3
WHATSAPP_MIN_DELAY_MS=1000
WHATSAPP_MAX_DELAY_MS=30000
WHATSAPP_DAILY_SAFETY_BUDGET=1800
WHATSAPP_WORKER_SECRET=your_worker_secret
CRON_SECRET=your_vercel_cron_secret